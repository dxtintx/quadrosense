<Application
    x:Class="QuadroSense.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#808080</Color>
            <Color x:Key="SystemAccentColorLight1">#A0A0A0</Color>
            <Color x:Key="SystemAccentColorLight2">#C0C0C0</Color>
            <Color x:Key="SystemAccentColorLight3">#E0E0E0</Color>
            <Color x:Key="SystemAccentColorDark1">#606060</Color>
            <Color x:Key="SystemAccentColorDark2">#404040</Color>
            <Color x:Key="SystemAccentColorDark3">#202020</Color>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#171717" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#171717" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#171717" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#171717" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#171717" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <Color x:Key="PageBackground">#F5F5F5</Color>
                    <Color x:Key="PanelBackground">#FFFFFF</Color>
                    <Color x:Key="InkPrimary">#171717</Color>
                    <Color x:Key="InkSecondary">#525252</Color>
                    <Color x:Key="Hairline">#D6D6D6</Color>
                    <Color x:Key="AccentColor">#171717</Color>
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource PageBackground}" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{ThemeResource PanelBackground}" />
                    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{ThemeResource InkPrimary}" />
                    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{ThemeResource InkSecondary}" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource Hairline}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#111111" />
                    <Color x:Key="PageBackground">#111111</Color>
                    <Color x:Key="PanelBackground">#1B1B1B</Color>
                    <Color x:Key="InkPrimary">#F5F5F5</Color>
                    <Color x:Key="InkSecondary">#B8B8B8</Color>
                    <Color x:Key="Hairline">#383838</Color>
                    <Color x:Key="AccentColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource PageBackground}" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{ThemeResource PanelBackground}" />
                    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{ThemeResource InkPrimary}" />
                    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{ThemeResource InkSecondary}" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource Hairline}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
